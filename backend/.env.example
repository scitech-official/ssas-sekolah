# ==============================================================================
# SMART SCHOOL ATTENDANCE SYSTEM (SSAS) - ENVIRONMENT CONFIGURATION
# SMP NEGERI 3 JEMBER
# ==============================================================================

# Port Backend Server (Express)
PORT=5000

# PostgreSQL / Supabase Database Connection (Prisma)
# Supabase Transaction Pooler URL (Port 6543) untuk operasional runtime aplikasi
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Port 5432) untuk migrasi & schema sync (Prisma CLI)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Kunci Rahasia JSON Web Token (JWT) untuk Autentikasi Admin
# Ganti dengan string acak panjang dan aman pada lingkungan produksi
JWT_SECRET="smp3_jember_secret_key_super_secure_2026"

# URL Frontend (Client Application) untuk CORS & Redirection
CLIENT_URL="http://localhost:5173"

# Token Keamanan Rahasia Mesin Terminal Kios (Anti-Spoofing Barcode Scan)
# Terminal Kiosk gerbang harus mengirimkan token ini pada header 'x-kiosk-secret'
KIOSK_SECRET_KEY="smp3_kiosk_gate_token_2026"

# Token API WhatsApp Gateway (Fonnte API - https://fonnte.com)
# Kosongkan jika menggunakan Mode Simulator
FONNTE_API_TOKEN=""

# Mode Simulator WhatsApp (true: Log di console & DB tanpa potong kuota, false: Kirim pesan riil via Fonnte)
FONNTE_MOCK_MODE=true
